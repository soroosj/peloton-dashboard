# Peloton Dashboard - Credentials
# Copy this file to .env and fill in your values.
# NEVER commit .env to GitHub.

PELOTON_EMAIL=your_peloton_email@example.com
PELOTON_PASSWORD=your_peloton_password

# GitHub Personal Access Token
# Create at: github.com -> Settings -> Developer settings -> Personal access tokens -> Tokens (classic)
# Required scopes: repo (full)
GITHUB_TOKEN=your_github_token_here
