# Peloton Dashboard - Credentials
# Copy this file to .env and fill in your values.
# NEVER commit .env to GitHub.

# Peloton auth (Auth0 refresh token flow)
# To get a token: log out/in at members.onepeloton.com, then extract it from
# localStorage key:
#   @@auth0spajs@@::WVoJxVDdPoFx4RNewvvg6ch2mZ7bwnsM::https://api.onepeloton.com/::openid profile email offline_access
# The script rotates this token automatically after each run.
PELOTON_REFRESH_TOKEN=your_peloton_refresh_token_here

# GitHub Personal Access Token
# Create at: github.com -> Settings -> Developer settings -> Personal access tokens -> Tokens (classic)
# Required scopes: repo (full)
GITHUB_TOKEN=your_github_token_here
